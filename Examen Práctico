// FUNCIONES A UTILIZAR
void setPWM(uint8_t duty, uint8_t canal);
void delay(void);

// DEFINICIÓN DE VARIABLES
uint8_t duty1 = 0; // Ciclo de trabajo del canal para PWM1 (derecha)
uint8_t duty2 = 0; // Ciclo de trabajo del canal para PWM2 (izquierda)

int main(void)
{
	//CONFIGURACIÓN DE PINES DE ENTRADA Y SALIDA
    RCC->AHBENR |= RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOCEN | RCC_AHBENR_GPIOFEN;// Habilita el reloj de los puertos A, C y F

    // PA1: Pull-Down (decremento)
	GPIOA->MODER &= ~(3 << (1*2)); // Configura el modo como input
	GPIOA->PUPDR &= ~(3 << (1*2)); // Limpia configuración previa
	GPIOA->PUPDR |=  (2 << (1*2)); // Activa el input como Pull-Down

	// PA3: Pull-Down (decremento)
	GPIOA->MODER &= ~((3 << (3*2)));// Configura el modo como input
	GPIOA->PUPDR &= ~((3 << (3*2)));// Limpia configuración previa
	GPIOA->PUPDR |=  ((2 << (3*2)));// Activa el input como Pull-Down

	// PA2: Pull-Up (incremento)
	GPIOA->MODER &= ~(3 << (2*2));// Configura el modo como input
	GPIOA->PUPDR &= ~(3 << (2*2));// Limpia configuración previa
	GPIOA->PUPDR |=  (1 << (2*2));//Activa el input como Pull-Down

	// PF4: Pull-Up (incremento)
	GPIOF->MODER &= ~(3 << (4*2));// Configura el modo como input
	GPIOF->PUPDR &= ~(3 << (4*2));// Limpia configuración previa
	GPIOF->PUPDR |=  (1 << (4*2));//Activa el input como Pull-Down

	// PC6 y PC7 como función alternativa para PWM (AF1 - TIM3)
	GPIOC->MODER &= ~((3 << (6*2)) | (3 << (7*2)));// Configura el modo como input
	GPIOC->MODER |=  ((2 << (6*2)) | (2 << (7*2)));// Limpia configuración previa
	GPIOC->AFR[0] &= ~((0xF << (6*4)) | (0xF << (7*4)));
	GPIOC->AFR[0] |=  ((1 << (6*4)) | (1 << (7*4)));

	//CONFIGURACIÓN DE TIMER3 COMO PWM Y CANALES A USAR
	RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;

	TIM3->PSC = 7;     // 8 MHz / (7+1) = 1 MHz
	TIM3->ARR = 999;   // 1 kHz

	// PWM1 - CH1
	TIM3->CCMR1 |= (6 << 4) | (1 << 3);
	TIM3->CCER |= (1 << 0);

	// PWM2 - CH2
	TIM3->CCMR1 |= (6 << 12) | (1 << 11);
	TIM3->CCER |= (1 << 4);

	TIM3->CR1 |= (1 << 7);  // ARPE
	TIM3->CR1 |= (1 << 0);  // CEN

	//Loop para siempre
	 for (;;) {
		 // BOTÓN PA2 : INCREMENTAR DERECHA
		 if ((GPIOA->IDR & (1 << 2)) == 0){  // Condicición: Si se presiona (nivel bajo por pull-up)

			 duty2 = 0;                     // Apaga PWM2 (Izquierda) para proteger el driver
			 setPWM(duty1, 1);              // Actualiza PWM1 (canal 1)
			 setPWM(0, 2);                  // Apaga PWM2 (canal 2)
			 delay();                   // Pausa de protección
		 }

		 // BOTÓN PA1 : DECREMENTAR DERECHA
		 if ((GPIOA->IDR & (1 << 1)) != 0){  // Condicición: Si se presiona (nivel alto por pull-down)
			 if (duty1 > 0) duty1 -= 10;    // Reduce duty en pasos de 10 %

			 duty2 = 0;						// Apaga PWM2 (Izquierda) para proteger el driver
			 setPWM(duty1, 1);				// Actualiza PWM1 (canal 1)
			 setPWM(0, 2);					// Apaga PWM2 (canal 2)
			 delay();					// Pausa de protección
		 }

		 // BOTÓN PF4 : INCREMENTAR IZQUIERDA
		 if ((GPIOF->IDR & (1 << 4)) == 0) {  // Condicición: Si se presiona (nivel bajo por pull-up)
			 if (duty2 < 100) duty2 += 10;

			 duty1 = 0;                     // Apaga PWM1 (Derecha) para proteger el driver
			 setPWM(duty2, 2);              // Actualiza PWM2 (canal 2)
			 setPWM(0, 1);                  // Apaga PWM1 (canal 1)
			 delay();					// Pausa de protección
		 }

		 // BOTÓN PA3 : DECREMENTAR IZQUIERDA
		 if ((GPIOA->IDR & (1 << 3)) != 0) {  // Condicición: Si se presiona (nivel alto por pull-down)
			 if (duty2 > 0) duty2 -= 10;

			 duty1 = 0;						// Apaga PWM1 (Derecha) para proteger el driver
			 setPWM(duty2, 2);				// Actualiza PWM2 (canal 2)
			 setPWM(0, 1);					// Apaga PWM1 (canal 1)
			 delay();					// Pausa de protección
		 }
	 }
}

		 // SE INDICA EL CICLO DE TRABAJO DEL CANAL ESPECIFICADO
		 void setPWM(uint8_t duty, uint8_t canal)
		 {
		     uint16_t valor = duty * 10; // Convierte de 0-100% a 0-1000

		     if (canal == 1)
		         TIM3->CCR1 = valor;     // Aplica duty al canal 1
		     else if (canal == 2)
		         TIM3->CCR2 = valor;     // Aplica duty al canal 2
		 }

		 // Delay simple para evitar múltiples lecturas por rebote de botón
		 void delay(void)
		 {
		     for (volatile int i = 0; i < 100000; i++); // Bucle vacío
		 }

