void PWM_CH1_Init(int duty_cycle)
{
 // 1. Habilita el reloj para GPIOC (bit 19)
 RCC->AHBENR |= (1 << 19); // 0b10000000000000000000
 // 2. Configura PC6 como función alterna (MODER6 = 0b10)
 GPIOC->MODER &= ~(0b11 << 12); // Limpia bits 13:12
 GPIOC->MODER |= (0b10 << 12); // MODER6 = 0b10 (alternate function)
 // 3. Habilita reloj de TIM3 (bit 1)
 RCC->APB1ENR |= (1 << 1); // 0b10
 // 4. Configura el temporizador
 TIM3->PSC = 7; // Prescaler = 7 → Ftimer = 8MHz / (7 + 1) = 1MHz
 TIM3->ARR = 999; // Periodo de 1ms
 TIM3->CCR1 = duty_cycle * 10; // (% duty cycle)
 // 5. PWM mode 1 en canal 1 + preload enable
 TIM3->CCMR1 |= (0b110 << 4); // OC1M = 110 → PWM mode 1
 // 6. Habilita la salida de canal 1
 TIM3->CCER |= (1 << 0); // CC1E = 1
 // 7. Inicia el temporizador
 TIM3->CR1 |= (1 << 0); // CEN = 1
}

